# -----------------------------------------------------------------------------
# Environment template — ALL credentials and secrets for this system live here.
#
# Setup:  cp .env.example .env     (.env is gitignored — never commit it)
#
# Fill every blank below before `docker compose up`. Generate strong values
# with:   openssl rand -base64 48 | tr -d '\n'
# -----------------------------------------------------------------------------

# --- Django ------------------------------------------------------------------

# Required — Compose fails fast if unset (`${SECRET_KEY:?…}`). No default.
SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- Database (shared-services PostgreSQL container) -------------------------
# Local dev uses the shared instance from ~/projects/shared-services.
# Bring it up first:  cd ~/projects/shared-services && docker compose up -d postgres
# These values must match that container (or your own Postgres). Required:
# Compose fails fast if POSTGRES_PASSWORD is unset — there is no default.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=

# Native Django persistent connections (card a8g83e7c).
# Maps to Django's CONN_MAX_AGE setting (seconds to keep a connection open
# across requests). Default off — Django closes per request.
#   unset / empty  -> Django default (close after each request; no pooling)
#   0              -> explicitly close every request (same as default at runtime)
#   >0 (e.g. 60)   -> reuse connections for up to N seconds; enables connection
#                      health checks (CONN_HEALTH_CHECKS=True) so stale
#                      connections are recycled automatically.
# This is NOT a pgbouncer pool — it is Django's built-in per-process
# persistent connections. See docs/architecture.md.

# --- Read replicas (optional; card 79e887g9) --------------------------------
# Comma-separated postgres:// URLs. Blank/empty = no replicas, single primary,
# no routing (behavior identical to today, no DATABASE_ROUTERS installed).
# When set, Django adds one alias per URL (replica_0, replica_1, ...) and
# installs a router that sends reads to a random replica while all writes,
# relations, and migrations stay on 'default'.
# The same DB_CONN_MAX_AGE pooling rules apply to each replica alias.
# Example:
# DB_REPLICA_URLS=postgres://shop:s3cret@replica1:5432/shop,postgres://shop:s3cret@replica2:5432/shop
# Caveat: the router does NOT provide read-after-write stickiness. Flows that
# must read their own write should use QuerySet.using('default'). Recommended
# for catalog/browse read-scaling only. Ensure actual streaming replication
# exists before enabling.

# --- Redis / Celery ----------------------------------------------------------
# Celery broker/result URLs are wired per-service in docker-compose.yml:
# broker = RabbitMQ, result backend = the shared Redis instance
# (~/projects/shared-services) on localhost, DB 1.
# Django cache (rate limiting) = DB 2 of that same instance; Compose wires it automatically.
# For a local runserver, uncomment:
# REDIS_CACHE_URL=redis://localhost:6379/2

# --- Recommendations (card 45ba5cfh) -----------------------------------------
# Price band (as a fraction) for "you might also like" recommendations: a
# recommended product must be within this ±% of the viewed product's price.
# Default 0.5 = ±50%. Tune to widen/narrow the spread without a code change.
# RECOMMENDATION_PRICE_TOLERANCE=0.5

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ----------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CDN (static assets) — card 327eeba2, Phase 3.1 caching --------------------
# Optional: serve collected static files from a public CDN origin.
# Set STATIC_CDN_URL to a schemed URL ending in '/' (e.g. https://cdn.example.com/)
# to route {% static %} URLs to the CDN with manifest-versioned filenames.
# Leave both blank to serve static files from the app itself via WhiteNoise at /static/.
# Media files are NEVER routed to the CDN — they stay at /media/ served by the app.
# Run collectstatic after enabling so staticfiles.json + hashed names exist.
# STATIC_CDN_URL=https://cdn.example.com/
# STATIC_CDN_MANIFEST=true   # default when STATIC_CDN_URL is set; false keeps
#                            # WhiteNoise's compressed-manifest storage (non-strict)

# --- Email -------------------------------------------------------------------
# Optional — default is Django's console email backend.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# (SMTP host/user/password go through the Django email backend config — see docs/production.md)

# --- OAuth (social login) ----------------------------------------------------
# Optional — Google OAuth2 via django-allauth (card hhde4h24). Leave BOTH blank
# to keep social login fully disabled — the app behaves as if allauth were not
# installed. Create credentials at https://console.cloud.google.com/ (APIs &
# Services > Credentials > Create OAuth client ID, type "Web application") and
# register this authorized redirect URI:
#   http://localhost:8089/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Reverse proxy (optional Compose profile `reverse-proxy`; see README) ---
# Trust X-Forwarded-Proto / Host from nginx when not hitting Gunicorn directly.
# DJANGO_BEHIND_PROXY=1

# Production HTTPS: list scheme+host+column(port) for every origin that POSTs to Django.
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Prefer HTTP→HTTPS at nginx. Turn on only if Django terminates TLS itself.
# SECURE_SSL_REDIRECT=false

# HSTS (optional). Enable only after HTTPS works end-to-end.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false

# --- Logging (structured / observability) -------------------------------------
# Card 6cc44f8g — structured JSON logging with request-correlation IDs.
#
# LOG_JSON controls the output format:
#   unset (default)  -> JSON when DEBUG=False, plain text when DEBUG=True
#   LOG_JSON=1       -> always JSON (production)
#   LOG_JSON=0       -> always plain text (debugging)
# Every log line includes a "request_id" field (empty when not in a request
# context, e.g. Celery worker startup or manage.py commands). Inbound HTTP
# requests with an "X-Request-Id" header reuse that ID; otherwise a fresh
# uuid4 is generated and echoed back on the response header.
# LOG_LEVEL=DEBUG/INFO/WARNING/ERROR/CRITICAL  (default INFO)
# LOG_JSON=1
# LOG_LEVEL=INFO

# --- Content Security Policy ------------------------------------------------
# Optional violation reporting endpoint (browser -> collector). Only wired to
# the web service in Compose; empty disables the report-uri directive.
# CSP_REPORT_URI=https://your-collector.example.com/csp-report

# --- Prometheus metrics (card g37aggbd) --------------------------------------
# Optional — off by default. When set to 1/true/yes the /metrics endpoint
# serves Prometheus exposition (HTTP request counts, latencies, order
# revenue, Celery task counts) and /health returns a DB-probed liveness status.
# Prometheus can then scrape http://localhost:8089/metrics.
# PROMETHEUS_ENABLED=1

# Optional IP allowlist for /metrics (comma-separated). When set, only
# requests whose REMOTE_ADDR matches one of these IPs get through; everything
# else gets 403. Leave empty for open access (use a reverse proxy to restrict
# in production). Set to 127.0.0.1 for local scraping or the Prometheus
# container's Docker-network IP for production.
# PROMETHEUS_METRICS_ALLOWED_IPS=127.0.0.1

# --- Grafana dashboards (card 3c3b2e3a) ------------------------------------
# Optional monitoring stack (Prometheus + Grafana), started via Compose profile:
#   docker compose --profile monitoring up -d
# Defaults below; override in .env as needed.
# Prometheus UI port (default 9090), Grafana UI port (default 3000).
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# Grafana admin credentials — CHANGE from defaults in production.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=changeme
# URL Prometheus uses for Grafana data-source queries (internal Docker network).
# PROMETHEUS_URL=http://prometheus:9090

# --- Sentry error tracking (card 5ggb4929 — Phase 4.1 monitoring) -------------
# Optional — off by default. Sentry is fully opt-in: leave SENTRY_DSN blank to
# keep the app behaving as if Sentry were not installed (no SDK import, no
# network at startup, no effect on tests or local dev). Set it to a real DSN
# from your Sentry project to enable error tracking across the web app,
# background Celery tasks, and management commands.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#
# Environment / release tagging in Sentry:
# SENTRY_ENVIRONMENT=production   # default: 'unknown'
# SENTRY_RELEASE=                 # default: auto from GIT_COMMIT / APP_VERSION / 'django-ecommerce@unreleased'
#
# Sampling (control cost + volume):
# SENTRY_TRACES_SAMPLE_RATE=0.2   # transaction sampling (default 0.2)
# SENTRY_PROFILES_SAMPLE_RATE=0.0 # profiling (default off)
#
# Privacy / sensitive-data scrubbing (all on by default when Sentry is enabled):
# SENTRY_SEND_DEFAULT_PII=0       # do NOT auto-attach Django user/PII (default false)
# SENTRY_SCRUB_REQUEST_HEADERS=1  # scrub Authorization/Cookie/Set-Cookie from request data
# SENTRY_SCRUB_REQUEST_COOKIES=1  # scrub sessionid/csrftoken cookie values
# SENTRY_SCRUB_PAYMENT_DATA=1     # redact card number, CVC, expiry, Stripe secret keys, etc.
# SENTRY_SENSITIVE_FIELDS=        # extra comma-separated field suffixes to scrub (extends payment set)
#
# Integration toggles:
# SENTRY_CELERY_ENABLED=1         # CeleryIntegration (task errors, failures)
# SENTRY_DJANGO_ENABLED=1         # DjangoIntegration (SQL, request errors)
